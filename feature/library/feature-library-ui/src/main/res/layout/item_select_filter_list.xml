<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="be.florien.anyflow.feature.library.domain.model.FilterItem" />

        <variable
            name="artConfig"
            type="be.florien.anyflow.common.ui.data.ImageConfig" />

        <variable
            name="selected"
            type="boolean" />

        <import type="android.view.View" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/infoView"
            android:layout_width="@dimen/minClickableSize"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:background="@color/accentLightPlus"
            android:padding="@dimen/smallDimen"
            android:src="@drawable/ic_info" />

        <be.florien.anyflow.common.widget.CheckableConstraintLayout
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_blue_selectable_ripple"
            android:checked="@{selected}"
            android:minHeight="@dimen/minClickableSize">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="@dimen/imageSize"
                android:layout_height="@dimen/imageSize"
                android:layout_margin="8dp"
                android:contentDescription="@null"
                app:imageSource="@{artConfig}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/filterName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:gravity="start"
                app:textConfig="@{item.title}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toEndOf="@+id/imageView"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/filterSubName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:gravity="start"
                app:textConfig="@{item.subtitle}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toEndOf="@+id/imageView"
                app:layout_constraintTop_toBottomOf="@id/filterName"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/filterSubSubName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:gravity="start"
                app:textConfig="@{item.subsubtitle}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toEndOf="@+id/imageView"
                app:layout_constraintTop_toBottomOf="@id/filterSubName"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/songDuration"
                style="@style/Chip"
                isVisiblePresent="@{item.duration != null}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/listItemPadding"
                android:background="@drawable/bg_corner_radius_partial"
                android:text="@{item.duration}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="3:45" />
        </be.florien.anyflow.common.widget.CheckableConstraintLayout>
    </FrameLayout>
</layout>
